{
  "url": "https://locomotive.ca",
  "title": "Locomotive | Montreal web agency",
  "category": "Creative Studios & Interactive Experiences",
  "design_style": "Smooth Inertia Scroll / Kinetic Editorial Typography",
  "svg_icon_count": 0,
  "tokens": {
    "css_variables": {
      "--color": "#FFFFFF",
      "--color-bg": "#000000",
      "--spacing-micro-mobile": "8",
      "--spacing-micro": "14",
      "--spacing-tiny-mobile": "20",
      "--spacing-tiny": "20",
      "--spacing-small-mobile": "30",
      "--spacing-small": "30",
      "--spacing-medium-mobile": "40",
      "--spacing-medium": "40",
      "--spacing-large-mobile": "52",
      "--spacing-large": "80",
      "--spacing-big-mobile": "80",
      "--spacing-big": "150",
      "--spacing-huge-mobile": "100",
      "--spacing-huge": "200",
      "--spacing-enormous-mobile": "140",
      "--spacing-enormous": "250",
      "--border": "solid var(--border-size)",
      "--grid-columns": "4",
      "--grid-gutter": "calc(20px/2)",
      "--grid-margin": "1.3333333333rem",
      "--header-height": "4rem",
      "--head-padding-vh": "0.25",
      "--about-head-content-offset-vh": "0.20",
